# Copy to .env on the server only — .env is gitignored
# cp .env.example .env && nano .env

# Subdomain for this app (no https://) — used by nginx/apache + certbot
APP_HOST=social.example.com

# App listens on localhost only; nginx proxies 443 -> this port
PORT=8000

# Auto-detected if unset: apache or nginx (most VPS use nginx)
# REVERSE_PROXY=nginx

# Replicate API token (passed to systemd; overrides config.json)
REPLICATE_API_TOKEN=r8_paste_your_token_here
